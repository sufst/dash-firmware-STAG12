              "hiddenFlag": "!((vcu_ctrl_state == \"TS Button Wait\") || (vcu_ctrl_state == \"Wait Neg AIR\" || vcu_ctrl_state == \"Precharge Wait\") || (vcu_ctrl_state == \"R2D Wait\") || (vcu_ctrl_state == \"TS Run Fault\"))",
              "hiddenFlagType": "expression",
              "clickableFlagType": "literal",
              "flagScrollbarMode": "",
