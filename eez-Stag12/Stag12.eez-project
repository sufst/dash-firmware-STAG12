                  "MAIN": {
                    "DEFAULT": {
                      "text_color": "Text",
                      "text_font": "b612_36",
                      "text_align": "CENTER"
                    }
                  }
                }
              },
              "group": "",
              "groupIndex": 0,
              "text": "(vcu_ctrl_state == \"TS Button Wait\") ? \"Press TS_ON (left)\" : (vcu_ctrl_state == \"Wait Neg AIR\" || vcu_ctrl_state == \"Precharge Wait\") ? \"Precharging...\" : (vcu_ctrl_state == \"R2D Wait\") ? \"Press R2D (right)\" : (vcu_ctrl_state == \"TS Run Fault\") ? \"Fault: Press TS_OFF (left)\" : \"\"",
              "textType": "expression",
              "longMode": "WRAP",
              "recolor": false,
              "previewValue": "Press TS_ON (left)",
              "useStaticText": true
            },
